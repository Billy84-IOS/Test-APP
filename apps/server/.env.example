DATABASE_URL="postgresql://cardtable:cardtable@localhost:5432/cardtable"
PORT=4000
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=cardtable_session
NODE_ENV=development

# --- Sécurité ---
# Limitation du nombre de requêtes sur /auth/* et les actions sensibles.
# Ne le désactive JAMAIS en production : uniquement pour les tests.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=20

# Base dédiée aux tests automatisés (elle est vidée entre chaque test).
TEST_DATABASE_URL="postgresql://cardtable:cardtable@localhost:5432/cardtable_test"
