# Copie ce fichier en .env (racine, pour Docker Compose) et adapte les
# valeurs. Chaque app a aussi son propre .env (voir apps/server/.env.example
# et apps/web/.env.example) pour le développement local sans Docker.

# --- Base de données ---
POSTGRES_USER=cardtable
POSTGRES_PASSWORD=change_me_en_production
POSTGRES_DB=cardtable
DATABASE_URL=postgresql://cardtable:change_me_en_production@postgres:5432/cardtable

# --- Serveur ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=cardtable_session
# Ne désactive le rate limiting que pour les tests, jamais en production.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=20

# --- Web ---
API_URL=http://localhost:4000
