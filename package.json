{
  "name": "cardtable",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:shared": "pnpm --filter @cardtable/shared build",
    "dev:web": "pnpm build:shared && pnpm --filter @cardtable/web dev",
    "dev:server": "pnpm build:shared && pnpm --filter @cardtable/server dev",
    "build": "pnpm -r build",
    "start:server": "pnpm --filter @cardtable/server start",
    "start:web": "pnpm --filter @cardtable/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "db:generate": "pnpm --filter @cardtable/server prisma generate",
    "db:migrate": "pnpm --filter @cardtable/server prisma migrate dev",
    "db:deploy": "pnpm --filter @cardtable/server prisma migrate deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
